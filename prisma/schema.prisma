generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Idea {
  id            String   @id @default(uuid())
  title         String
  description   String?
  category      String?
  type          String?
  model         String?
  status        String?
  kanbanTaskId  String?
  rejectionReason String?
  timestamp     DateTime @default(now())

  @@index([category])
  @@index([type])
}

model AgentState {
  id             String    @id
  name           String
  emoji          String?
  role           String?
  status         String    @default("offline")
  lastActive     DateTime?
  tasksCompleted Int       @default(0)
  totalCost      Float     @default(0)
  currentTask    String?
  recentActivity Json?     @default("[]")
  updatedAt      DateTime  @updatedAt
}

model AgentBusMessage {
  id        String   @id @default(uuid())
  fromAgent String
  toAgent   String
  type      String
  content   String
  metadata  Json?
  read      Boolean  @default(false)
  timestamp DateTime @default(now())

  @@index([toAgent, read])
  @@index([fromAgent])
}

model BattleRoyaleBot {
  id        String   @id
  state     Json
  updatedAt DateTime @updatedAt
}

// ─── Generic Key-Value Store ────────────────────────────────────

model DataStore {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

// ─── Daily Briefs ───────────────────────────────────────────────

model Brief {
  id        String   @id @default(cuid())
  date      String   @unique
  content   String   @db.Text
  source    String   @default("brief")
  createdAt DateTime @default(now())
}

// ─── Missions ───────────────────────────────────────────────────

model Mission {
  id          String   @id @default(uuid())
  agentId     String
  title       String
  description String   @db.Text
  status      String   @default("pending") // pending, active, completed, failed
  priority    String   @default("medium") // high, medium, low
  result      String?  @db.Text
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([agentId])
  @@index([status])
}

// ─── Hermes bus (Hermy HQ website ↔ Hermes on the Mac mini) ─────
// Shared Postgres is the message bus. A bridge on the mini polls
// AgentRequest, runs approved/safe ones via the `hermes` CLI, and
// mirrors kanban tasks + activity back into HermesTask / AgentEvent.

model AgentRequest {
  id            String    @id @default(cuid())
  origin        String    @default("web")     // "web" | "hermes"
  kind          String    @default("oneshot") // "oneshot" | "kanban" | "chat"
  title         String
  prompt        String?
  assignee      String    @default("default") // which Hermes profile/worker should run this (kanban assignee)
  sideEffecting Boolean   @default(false)
  status        String    @default("queued")  // queued | awaiting_approval | approved | running | done | failed | rejected
  result        String?
  error         String?
  hermesTaskId  String?
  decidedAt     DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AgentEvent {
  id        String   @id @default(cuid())
  kind      String   @default("activity") // activity | run | status | memory
  title     String
  detail    String?
  agent     String?
  level     String   @default("info")     // info | up | warn | down
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model HermesTask {
  id              String    @id                   // Hermes task id
  board           String    @default("default")
  title           String
  assignee        String?
  status          String    @default("todo")
  priority        Int?
  result          String?
  startedAt       DateTime?
  completedAt     DateTime?
  workerPid       Int?
  workerStartedAt String?
  lastHeartbeatAt DateTime?
  currentRunId    Int?
  blockKind       String?
  currentStepKey  String?
  lastFailureError String? @db.Text
  updatedAt       DateTime  @default(now())
  syncedAt        DateTime  @updatedAt

  @@index([board])
  @@index([status])
}

// Mirrors kanban `task_events` — the play-by-play behind each task (claimed,
// spawned, heartbeat, commented, completed, blocked, ...) so the dashboard
// can show a live "what's it doing right now" feed, not just a status pill.
model HermesTaskEvent {
  id        Int      @id                   // kanban task_events.id (source of truth, not autoinc here)
  taskId    String
  runId     Int?
  kind      String
  payload   String?  @db.Text              // raw JSON string from kanban, parsed client-side
  createdAt DateTime
  syncedAt  DateTime @default(now())

  @@index([taskId])
  @@index([createdAt])
}
